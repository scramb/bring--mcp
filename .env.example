# --- Bring! account (required) ---
BRING_EMAIL=you@example.com
BRING_PASSWORD=your-bring-password

# --- MCP server auth (required) ---
# One or more API keys, comma-separated. Clients must send one as either
#   Authorization: Bearer <key>   or   X-API-Key: <key>
# Generate a strong value, e.g.:  openssl rand -hex 32
MCP_API_KEY=change-me-to-a-long-random-string

# --- Optional ---
# Default shopping list (name or UUID). If unset, the first list is used.
BRING_DEFAULT_LIST=
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
LOG_LEVEL=INFO
# MCP response mode. true = plain-JSON Streamable HTTP responses (default).
# Set to false only if you need SSE-framed responses for streaming clients.
MCP_JSON_RESPONSE=true
