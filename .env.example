# --- Required ---
# The public base URL clients reach this server at (no trailing slash). It is
# the OAuth issuer; the MCP endpoint is PUBLIC_URL + MCP_PATH.
PUBLIC_URL=http://localhost:8080
# Postgres for OAuth clients, tokens and linked Bring! accounts.
DATABASE_URL=postgres://bring:bring@postgres:5432/bring
# Fernet key the Bring! refresh tokens are encrypted with. Generate one:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=change-me

# --- Optional ---
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
LOG_LEVEL=INFO
# MCP response mode. true = plain-JSON Streamable HTTP responses (default).
MCP_JSON_RESPONSE=true
# Lifetimes of the OAuth tokens this server issues, in seconds.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=7776000
